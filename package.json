{
  "name": "@viyuni/bevent-relay",
  "version": "0.0.1",
  "description": "Typed Bilibili live event listener and parser utilities.",
  "homepage": "https://github.com/viyuni/bevent-relay#readme",
  "bugs": {
    "url": "https://github.com/viyuni/bevent-relay/issues"
  },
  "license": "MIT",
  "author": "Viyuni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viyuni/bevent-relay.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./events": "./dist/events.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "ready": "vp check && vp test && vp pack",
    "prepublishOnly": "vp run build",
    "release": "vpr ready && vp exec bumpp",
    "prepare": "vp config"
  },
  "dependencies": {
    "@viyuni/cookie-sync-client": "^0.0.3",
    "bilibili-live-ws": "^6.3.1",
    "cookie": "^1.1.1",
    "ky": "^2.0.2",
    "volta-json-ptr": "^0.0.1-beta.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}
